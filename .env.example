DATABASE_URL=postgresql+psycopg://tmp:tmp@localhost:5432/tmplatform
REDIS_URL=redis://localhost:6379/0
WORKSPACE_ROOT=/var/tmp/tmp-workspaces
MAX_REPO_MB=500
CLONE_TIMEOUT_SEC=300
SCAN_TIMEOUT_SEC=1800
RISK_MODEL_PATH=policy/risk/risk-model.yaml
# All three activate OIDC and disable the local sign-in form.
# Entra ID issuer: https://login.microsoftonline.com/<tenant-id>/v2.0
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPES=openid email profile
SESSION_MAX_AGE=28800
SESSION_HTTPS_ONLY=false
SESSION_SECRET=change-me
WEBHOOK_SECRET=change-me
API_TOKEN=change-me
GIT_TOKEN=
